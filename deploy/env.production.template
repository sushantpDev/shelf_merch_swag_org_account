# Production origin template for the process on 72.62.76.198:8080 (https://shelfmerch.io).
# Do not point MCP_OAUTH_ISSUER at staging from this file.
# Staging uses deploy/env.staging.template. Fill in secrets — never commit the real `.env`.

# --- Server ---
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# --- Data stores ---
MONGO_URL=mongodb://<user>:<password>@<cluster>.mongodb.net/shelfmerch?ssl=true&authSource=admin
REDIS_URL=redis://127.0.0.1:6379

# --- Auth (min 16 chars each in production) ---
JWT_ACCESS_SECRET=<generate-a-long-random-secret>
JWT_REFRESH_SECRET=<generate-a-long-random-secret>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Zoho People (optional) ---
# Register BOTH local and production URIs in Zoho API Console.
# Production must be exactly (no trailing slash):
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://shelfmerch.io/api/integrations/zoho/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
TOKEN_ENCRYPTION_KEY=

# --- File storage ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=shelfmerch.io
STORAGE_DRIVER=auto

# --- Payments / SMS / Email ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SLFMRH
MSG91_OTP_TEMPLATE_ID=
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Public HTTPS base for transactional email brand images (logo + hero).
# Required for correct inbox images in production.
EMAIL_ASSET_BASE_URL=https://shelfmerch.io/email-assets

# --- Public URLs (this VPS) ---
APP_URL=http://72.62.76.198:8080
CORS_ORIGINS=http://72.62.76.198:8080

# --- Frontend build (same-origin — API serves the SPA in production) ---
VITE_API_URL=/api/v1
VITE_USE_MOCKS=false
# Vanity shop hosts: acme.shelfmerch.io. Staging uses /s/{slug} on staging.shelfmerch.io.
VITE_SHOP_REDEEM_DOMAIN=shelfmerch.io
# Google Tag Manager (baked into the SPA at build time via apps/web/index.html)
VITE_GTM_ID=GTM-T344HWXR
# OpenAI Ads Measurement Pixel. Keep empty until consent review and a rebuild.
# Do not put a live Pixel ID here yet.
VITE_OPENAI_PIXEL_ID=
# Keep empty. Set to true only after Shelf Merch explicitly accepts automatic
# advanced matching. True does not disable matching. OpenAI provides no supported
# way to turn it off. The pixel still loads only after advertising consent.
# Any other value keeps the OpenAI script unloaded.
VITE_OPENAI_AAM_REVIEWED=
