# Staging environment names for the process that serves https://staging.shelfmerch.io.
# Copy to the staging checkout as `.env`. Fill secrets on the server. Never commit the filled file.
# Do not reuse production JWT secrets, MCP signing keys, cookie secrets, or the production database.
# Verified 2026-10-30: this hostname is Cloudflare HTTPS and a different Node process from
# https://shelfmerch.io and http://72.62.76.198:8080. Do not apply this file to that origin.

# --- Server ---
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
# Cloudflare connects to this Node process. One trusted hop. Use 2 only if a second proxy is inserted.
TRUST_PROXY=1

# --- Data stores ---
# Database name must not be the production database. Startup logs the name only.
MONGO_URL=mongodb+srv://<staging-user>:<password>@<staging-cluster>.mongodb.net/<staging-database>?ssl=true&authSource=admin
REDIS_URL=redis://127.0.0.1:6379

# --- Auth (staging-only values, min 16 characters each) ---
JWT_ACCESS_SECRET=<generate-a-staging-only-secret>
JWT_REFRESH_SECRET=<generate-a-staging-only-secret>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- MCP OAuth ---
# Origin only. No path, query, fragment, or trailing slash.
# Resource URL is derived: https://staging.shelfmerch.io/mcp
# There is no MCP_RESOURCE_URL setting.
MCP_OAUTH_ISSUER=https://staging.shelfmerch.io
# One-line private JWKS JSON. Same value on every staging replica. See deploy/mcp-oauth-staging.md.
MCP_OIDC_JWKS=
# At least 32 characters. Distinct from JWT_ACCESS_SECRET and from production.
MCP_OIDC_COOKIE_SECRET=
# Ignored because NODE_ENV=production. Keep false so a mis-set environment cannot widen MCP auth.
MCP_ALLOW_LEGACY_JWT=false

# --- Public URLs (also the /mcp host allowlist) ---
APP_URL=https://staging.shelfmerch.io
BASE_URL=https://staging.shelfmerch.io
CLIENT_URL=https://staging.shelfmerch.io
CORS_ORIGINS=https://staging.shelfmerch.io

# --- Frontend build (same-origin; set before npm run build) ---
VITE_API_URL=/api/v1
VITE_USE_MOCKS=false
VITE_SHOP_REDEEM_DOMAIN=shelfmerch.io
VITE_GTM_ID=
VITE_OPENAI_PIXEL_ID=
VITE_OPENAI_AAM_REVIEWED=

# Leave payment, SMS, and mailbox secrets as the existing staging values.
# Do not copy production Razorpay live keys into this file for an MCP test.
