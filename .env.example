# --- Server ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# Trusted reverse-proxy hops (Express trust proxy). Behind HAProxy = 1;
# behind Cloudflare -> HAProxy = 2. Must match the real topology or per-IP
# rate limits can be spoofed via X-Forwarded-For.
TRUST_PROXY=1

# --- Data stores ---
# MongoDB Atlas (required). MONGO_URL and MONGODB_URI are equivalent — use either.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shelfmerch
# Optional: Redis for login sessions, rate limiting, idempotency keys, BullMQ job queues.
# Sessions and idempotency fall back to MongoDB when Redis is unavailable; rate limits are skipped when Redis is down.
# Host port for `docker compose up redis`. Use 6380 when another Redis already owns 6379.
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Observability (Gap F) ---
# pino level: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
# Set to activate error reporting (requires `npm i @sentry/node`). Empty = disabled.
SENTRY_DSN=
# Set to enable distributed tracing (requires @opentelemetry/* packages). Empty = disabled.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Auth ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=24h

# --- MCP OAuth (authorization server on this API process) ---
# Public origin only, no path and no trailing slash. Production and staging must be https.
# Empty locally uses http://127.0.0.1:$PORT.
# Staging origin verified 2026-10-30: https://staging.shelfmerch.io
# The MCP resource is derived as ${MCP_OAUTH_ISSUER}/mcp. There is no MCP_RESOURCE_URL variable.
# MCP_OAUTH_ISSUER=https://staging.shelfmerch.io
# Private JWKS JSON (RFC 7517) with the same key on every API replica. Required when NODE_ENV=production.
# Generate on the server and store outside git. See deploy/mcp-oauth-staging.md.
# MCP_OIDC_JWKS=
# Cookie signing secret, at least 32 characters. Required when NODE_ENV=production. Not a JWT secret.
# MCP_OIDC_COOKIE_SECRET=
# Development only. Ignored when NODE_ENV=production, including the staging PM2 process.
MCP_ALLOW_LEGACY_JWT=false

# --- Embedded AI Copilot (dashboard) ---
# Keep false in production until explicitly approved. Staging/internal beta: true.
EMBEDDED_COPILOT_ENABLED=false
# Server-only — never expose to Vite/React.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDED_COPILOT_MAX_TOOL_LOOPS=4
EMBEDDED_COPILOT_MAX_INPUT_CHARS=4000
EMBEDDED_COPILOT_DAILY_USER_TOKENS=200000
EMBEDDED_COPILOT_DAILY_TENANT_TOKENS=1000000

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production example: https://shelfmerch.io/api/v1/auth/google/callback
GOOGLE_CALLBACK_URL=
BASE_URL=
# SPA route that receives tokens after OAuth (e.g. https://shelfmerch.io/auth/google)
CLIENT_URL=

# --- Zoho People OAuth (India) ---
# Register BOTH URIs in Zoho API Console → Server-based client → Authorized Redirect URIs:
#   Development (Vite proxies /api → Express :3001):
#     http://localhost:8080/api/integrations/zoho/callback
#   Production:
#     https://shelfmerch.io/api/integrations/zoho/callback
# Pathname must be exactly /api/integrations/zoho/callback (no trailing slash).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Local template default — switch to the production URI on the VPS.
ZOHO_REDIRECT_URI=http://localhost:8080/api/integrations/zoho/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# 32-byte AES-256-GCM key as 64-char hex (or base64). Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Merge.dev HRIS (server-only) ---
# Test access key from https://app.merge.dev/keys — never expose to the frontend.
MERGE_API_KEY=

# --- Slack OAuth (server-only) ---
# Register BOTH redirect URIs in Slack App → OAuth & Permissions → Redirect URLs:
#   Development (Vite proxies /api → Express):
#     http://localhost:8080/api/integrations/slack/callback
#   Production:
#     https://shelfmerch.io/api/integrations/slack/callback
# Pathname must be exactly /api/integrations/slack/callback (no trailing slash).
# Bot token scopes: channels:read, chat:write, chat:write.public
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional — when empty, derived as {BASE_URL||APP_URL}/api/integrations/slack/callback
SLACK_REDIRECT_URI=http://localhost:8080/api/integrations/slack/callback

# --- File storage (Cloudflare R2, S3-compatible) — Phase 3+ ---
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=shelfmerch-assets

# --- File storage (AWS S3) — used when R2 is not configured ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
# Optional custom domain or CloudFront base URL (e.g. https://shelfmerch.io)
S3_PUBLIC_BASE_URL=
# auto | local | s3 | r2 — use "local" when IAM lacks s3:PutObject
STORAGE_DRIVER=auto

# --- Payments (Razorpay) — only ONE credential set active at a time ---
# DEV (TEST): use rzp_test_* keys. LIVE: use rzp_live_* keys.
# Never commit real secrets. KEY_SECRET and WEBHOOK_SECRET stay server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard → Webhooks (backup to frontend verify)
RAZORPAY_WEBHOOK_SECRET=

# --- SMS / OTP (MSG91) — Phase 5 redemption + Phase 7 notifications ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SLFMRH
MSG91_OTP_TEMPLATE_ID=

# --- Email — Phase 7 (Gmail SMTP or other nodemailer service) ---
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Brand images for transactional emails (apps/web/public/email-assets/ + API /email-assets).
# Local/dev: leave empty → CID inline images (Gmail-safe; no data URIs / no localhost).
# Production: https://shelfmerch.io/email-assets
# Optional locally: set the production URL once the CDN is deployed to test HTTPS path.
EMAIL_ASSET_BASE_URL=
APP_URL=http://localhost:8080
# Comma-separated CORS origins allowed in production. Empty NO LONGER means
# "allow all" — cross-origin requests are refused unless the Origin is listed
# here or matches the request Host (same-origin unified server still works).
CORS_ORIGINS=
# Production Content-Security-Policy mode: report-only (default, safe) | enforce | off.
# Validate report-only in staging, then set CSP_MODE=enforce.
CSP_MODE=report-only

# --- Frontend ---
VITE_API_URL=http://localhost:3001/api/v1
VITE_USE_MOCKS=false
# Vanity shop hosts: {slug}.{domain}. Production builds: shelfmerch.io
# Staging (staging.shelfmerch.io) keeps same-origin /s/{slug} links instead.
VITE_SHOP_REDEEM_DOMAIN=shelfmerch.io
# Google Tag Manager container ID. Leave empty locally to disable GTM.
# Production builds: set VITE_GTM_ID=GTM-T344HWXR before `npm run build`.
VITE_GTM_ID=
# OpenAI Ads Measurement Pixel. Leave empty. An empty value does not load the
# pixel. Measurement also stays off until a visitor allows advertising
# measurement and VITE_OPENAI_AAM_REVIEWED is exactly true.
VITE_OPENAI_PIXEL_ID=
# Set to true only after Shelf Merch explicitly reviews and accepts automatic
# advanced matching. True does not disable matching. OpenAI provides no supported
# way to turn it off, so a loaded pixel hashes recognizable form details in the
# browser. Any other value keeps the OpenAI script unloaded.
VITE_OPENAI_AAM_REVIEWED=

# --- Production on VPS (e.g. 72.62.76.198) ---
# Copy deploy/env.production.template to .env on the server, then:
#   npm install && npm run build && pm2 start ecosystem.config.cjs
# Unified server on PORT=8080 serves API + SPA. Optional nginx on :80 → see deploy/nginx.conf.
# Production VITE_API_URL=/api/v1  (same-origin; set before `npm run build`)
